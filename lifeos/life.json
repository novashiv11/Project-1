 },
 "lead_overrides": [
  {
   "pattern": "passport|visa",
   "days": 180,
   "why": "many countries require 6+ months passport validity to enter"
  },
  {
   "pattern": "rent agreement|lease",
   "days": 60,
   "why": "time to renegotiate or move"
  },
  {
   "pattern": "insurance|policy|licen[cs]e|warranty|itr|tax",
   "days": 30,
   "why": "renewals and filings take paperwork"
  },
  {
   "pattern": "puc|fastag|exam",
   "days": 14,
   "why": "short validity or prep time"
  }
 ],
 "metrics": [
  {
   "name": "weight",
   "unit": "kg",
   "pattern": "\\bweight\\s*(?:is\\s*|=\\s*|:\\s*)?(\\d+(?:\\.\\d+)?)\\s*kg\\b",
   "per_subject": true
  },
  {
   "name": "mood",
   "unit": "/10",
   "pattern": "\\bmood\\s*(?:is\\s*|:\\s*)?(\\d{1,2})(?:\\s*/\\s*10)?\\b"
  },
  {
   "name": "sleep",
   "unit": "h",
   "pattern": "\\b(?:slept|sleep|neend)\\s*(?:of\\s*)?(\\d+(?:\\.\\d+)?)\\s*(?:h|hr|hrs|hours?|ghante)\\b"
  },
  {
   "name": "steps",
   "unit": "steps",
   "pattern": "\\b(\\d{3,6})\\s*steps\\b"
  },
  {
   "name": "distance",
   "unit": "km",
   "pattern": "\\b(?:ran|run|walked|walk|cycled)\\s*(\\d+(?:\\.\\d+)?)\\s*(?:km|k)\\b"
  },
  {
   "name": "water",
   "unit": "L",
   "pattern": "\\b(?:water|paani)\\s*(\\d+(?:\\.\\d+)?)\\s*(?:l|litres?|liters?)\\b"
  },
  {
   "name": "spent",
   "unit": "₹",
   "pattern": "(?:\\b(?:spent|kharcha|paid)\\s*(?:rs\\.?|inr|₹)?\\s*|₹\\s*)(\\d[\\d,]*(?:\\.\\d+)?)",
   "sum": true
  },
  {
   "name": "bp",
   "unit": "mmHg",
   "pattern": "\\bbp\\s*(\\d{2,3})\\s*/\\s*\\d{2,3}\\b"
  },
  {
   "name": "sugar",
   "unit": "mg/dL",
   "pattern": "\\b(?:sugar|glucose)\\s*(\\d{2,3})\\b"
  }
 ]
}
